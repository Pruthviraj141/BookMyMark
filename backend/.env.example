# ==============================================================================
# BookMyMark (SAVR) - Backend & Edge Worker Environment Variables
# Copy this file to .env before running local server or tests
# ==============================================================================

# Server Configuration (Local Development)
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=*

# Local Database (For standalone local dev without Supabase)
DATABASE_PATH=./data/savr.db

# JWT Secret for standalone local auth (Min 32 characters)
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Groq Cloud LLM API (Get free API key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Integration (Required for Edge Worker metadata enrichment & auth sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json
