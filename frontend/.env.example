# ==============================================================================
# BookMyMark (SAVR) - Frontend Environment Variables
# Copy this file to .env before starting the development server or building the APK
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous / Publishable Key (From Supabase Dashboard -> Settings -> API)
# Safe to expose in client builds with Row Level Security (RLS) enabled
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# Edge Worker API Base URL (Cloudflare Worker for scraping & Groq AI enrichment)
# Defaults to your deployed Cloudflare worker or http://localhost:3000 for local dev
VITE_API_BASE_URL=https://savr-api.your-subdomain.workers.dev
