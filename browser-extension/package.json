{
  "name": "bookmymark-extension",
  "version": "1.0.0",
  "description": "BookMyMark Browser Extension for Chrome, Firefox and Brave",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "npm run zip:chrome && npm run zip:firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "firefox": "./run-firefox.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wxt": "^0.19.0"
  }
}
